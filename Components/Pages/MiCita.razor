@page "/mi-cita"
@inject IDbContextFactory<AppDb> F
@inject AuditoriaService Aud
<PageTitle>Consultar mi cita – ConfiDent</PageTitle>
<div class="band hero-band"><div class="in">
    <div>
        <h1>Consulte o cancele su cita</h1>
        <p>Ingrese su cédula y el teléfono con el que se registró para ver sus próximas citas. Solo mostramos los datos de la cita, nunca su información clínica.</p>
        <div class="chips"><span class="chip2">Rápido</span><span class="chip2">Sin llamadas</span><span class="chip2">Seguro</span></div>
    </div>
    <form class="mc-card" @onsubmit="Buscar" @onsubmit:preventDefault>
        <h4 class="mb-3">Buscar mi cita</h4>
        <label class="form-label" for="mc-ced">Cédula</label>
        <input id="mc-ced" class="form-control form-control-lg mb-3" placeholder="001-010190-0001A" autocomplete="off" @bind="cedula" @bind:event="oninput" />
        <label class="form-label" for="mc-tel">Teléfono</label>
        <input id="mc-tel" class="form-control form-control-lg mb-3" inputmode="numeric" maxlength="8" placeholder="8 dígitos" autocomplete="off" @bind="tel" @bind:event="oninput" />
        <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@buscando">@(buscando ? "Buscando…" : "Consultar mi cita")</button>
        @if (msg != null) { <div class="alert alert-@(ok ? "success" : "info") mt-3 mb-0">@msg</div> }
    </form>
</div></div>
@if (citas != null)
{
    <div class="mt-4 mc-results">
    @foreach (var c in citas)
    {
        <div class="card card-body mb-3">
            <div class="d-flex flex-wrap justify-content-between gap-2">
                <div>
                    <h5 class="mb-1">@c.Servicio?.NombreServicio</h5>
                    <div>@c.FechaHora.ToString("dd/MM/yyyy") a las @c.FechaHora.ToString("HH:mm")</div>
                    <div class="text-muted">@c.Odontologo?.Nombre</div>
                </div>
                <div><span class="badge text-bg-@(c.Estado == "Solicitada" ? "warning" : "info")">@c.Estado</span></div>
            </div>
            <div class="mt-3 d-flex flex-wrap gap-2">
                @if (confirmar == c.Id) { <button type="button" class="btn btn-sm btn-danger" @onclick="() => Cancelar(c.Id)">Sí, cancelar mi cita</button><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => confirmar = null">No</button> }
                else { <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => confirmar = c.Id">Cancelar cita</button> }
                <a class="btn btn-sm btn-outline-primary" href="@WaReprog(c)" target="_blank" rel="noopener">Reprogramar por WhatsApp</a>
            </div>
        </div>
    }
    </div>
}
@if (citas == null)
{
    <section class="section">
        <h2 class="section-title">¿Cómo funciona?</h2>
        <ol class="steps mt-3">
            <li><b>Escriba sus datos</b><br /><span class="text-muted">cédula y teléfono con los que se registró.</span></li>
            <li><b>Vea sus citas</b><br /><span class="text-muted">fecha, hora, servicio y odontólogo.</span></li>
            <li><b>Cancele o reprograme</b><br /><span class="text-muted">cancele aquí o pida el cambio por WhatsApp.</span></li>
        </ol>
        <p class="text-muted mt-3">¿Aún no tiene cita? <a href="cita">Solicítela aquí</a> o vea los <a href="disponibilidad">horarios libres</a>.</p>
    </section>
}
@code {
    string cedula = "", tel = ""; string? msg;
    bool ok, buscando; Guid? pid, confirmar; List<Cita>? citas;
    static string WaReprog(Cita c) => DatosClinica.WaClinica($"Hola, quiero reprogramar mi cita del {c.FechaHora:dd/MM/yyyy} a las {c.FechaHora:HH:mm}.");
    async Task Buscar()
    {
        msg = null; citas = null; confirmar = null; ok = false;
        var ced = cedula.Trim().ToUpper(); var t = tel.Trim();
        if (ced == "" || t == "") { msg = "Escriba su cédula y su teléfono."; return; }
        if (Intentos.Bloqueado("cita:" + ced)) { msg = "Demasiados intentos. Espere unos minutos o escríbanos por WhatsApp."; return; }
        buscando = true;
        try
        {
            await using var db = await F.CreateDbContextAsync();
            var p = await db.Pacientes.FirstOrDefaultAsync(x => x.Cedula == ced && x.Telefono == t);
            if (p == null) { Intentos.Fallo("cita:" + ced, 5, TimeSpan.FromMinutes(10)); msg = "No encontramos citas con esos datos. Verifique su cédula y teléfono."; return; }
            Intentos.Ok("cita:" + ced);
            pid = p.IdPaciente;
            await Cargar(db);
        }
        finally { buscando = false; }
    }
    async Task Cargar(AppDb db)
    {
        var lista = await db.Citas.Include(c => c.Odontologo).Include(c => c.Servicio)
            .Where(c => c.PacienteId == pid && c.FechaHora >= DateTime.Now && c.Estado != "Cancelada" && c.Estado != "Realizada")
            .OrderBy(c => c.FechaHora).ToListAsync();
        citas = lista.Count > 0 ? lista : null;
        if (lista.Count == 0 && msg == null) msg = "No tiene citas próximas pendientes.";
    }
    async Task Cancelar(Guid id)
    {
        await using var db = await F.CreateDbContextAsync();
        var c = await db.Citas.FirstOrDefaultAsync(x => x.Id == id && x.PacienteId == pid);
        if (c == null) return;
        c.Estado = "Cancelada";
        await db.SaveChangesAsync();
        await Aud.Registrar("Paciente (web)", "Canceló su cita", pid);
        confirmar = null; msg = "Su cita fue cancelada. El horario quedó libre para otras personas."; ok = true;
        await Cargar(db);
    }
}
