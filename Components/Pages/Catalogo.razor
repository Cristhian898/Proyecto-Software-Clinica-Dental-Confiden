@page "/catalogo"
@attribute [Authorize(Roles = "Administrador")]
@inject IDbContextFactory<AppDb> F
<h2>Catálogo de servicios</h2>
<button class="btn btn-primary mb-3" @onclick="Nuevo">Nuevo servicio</button>
@if (edit != null)
{
    <EditForm Model="edit" OnValidSubmit="Guardar" class="card card-body mb-3"><DataAnnotationsValidator /><ValidationSummary />
        <div class="row g-2">
            <div class="col-md-4"><label class="form-label">Nombre</label><InputText class="form-control" @bind-Value="edit.NombreServicio" /></div>
            <div class="col-md-5"><label class="form-label">Descripción</label><InputText class="form-control" @bind-Value="edit.Descripcion" /></div>
            <div class="col-md-3"><label class="form-label">Precio (C$)</label><InputNumber class="form-control" @bind-Value="edit.Precio" /></div>
        </div>
        <div class="mt-3"><button class="btn btn-primary">Guardar</button> <button type="button" class="btn btn-outline-secondary" @onclick="() => edit = null">Cancelar</button></div></EditForm>
}
<div class="table-responsive"><table class="table table-sm align-middle bg-body"><thead><tr><th>Servicio</th><th>Descripción</th><th>Precio</th><th></th></tr></thead><tbody>
@foreach (var s in lista) { <tr><td>@s.NombreServicio</td><td>@s.Descripcion</td><td>@Precios.Texto(s)</td><td><button class="btn btn-sm btn-outline-primary" @onclick="() => Editar(s)">Editar</button></td></tr> }
</tbody></table></div>
@code {
    List<Servicio> lista = new(); Servicio? edit; bool nuevo;
    protected override async Task OnInitializedAsync() => await Cargar();
    async Task Cargar() { await using var db = await F.CreateDbContextAsync(); lista = await db.Servicios.OrderBy(s => s.NombreServicio).ToListAsync(); }
    void Nuevo() { edit = new(); nuevo = true; }
    void Editar(Servicio s) { edit = new Servicio { IdServicio = s.IdServicio, NombreServicio = s.NombreServicio, Descripcion = s.Descripcion, Precio = s.Precio }; nuevo = false; }
    async Task Guardar()
    {
        edit!.Precio = Math.Round(edit.Precio, 2);
        await using var db = await F.CreateDbContextAsync();
        if (nuevo) db.Servicios.Add(edit); else db.Servicios.Update(edit);
        await db.SaveChangesAsync(); edit = null; await Cargar();
    }
}
