@page "/odontologos"
@attribute [Authorize(Roles = "Administrador,Recepcionista")]
@inject IDbContextFactory<AppDb> F
<h2>Odontólogos</h2>
@if (err != null) { <div class="alert alert-danger">@err</div> }
<AuthorizeView Roles="Administrador" Context="auth">
    <button class="btn btn-primary mb-3" @onclick="() => nuevo = new()">Registrar odontólogo</button>
    @if (nuevo != null)
    {
        <EditForm Model="nuevo" OnValidSubmit="Guardar" class="card card-body mb-3"><DataAnnotationsValidator /><ValidationSummary />
            <div class="row g-2">
                <div class="col-md-4"><label class="form-label">Nombre</label><InputText class="form-control" @bind-Value="nuevo.Nombre" /></div>
                <div class="col-md-4"><label class="form-label">Especialidad</label><InputText class="form-control" @bind-Value="nuevo.Especialidad" /></div>
                <div class="col-md-4"><label class="form-label">Número de colegiado</label><InputText class="form-control" @bind-Value="nuevo.NumeroColegiado" /></div>
            </div>
            <div class="mt-3"><button class="btn btn-primary">Guardar</button> <button type="button" class="btn btn-outline-secondary" @onclick="() => nuevo = null">Cancelar</button></div></EditForm>
    }
</AuthorizeView>
<div class="table-responsive"><table class="table table-sm align-middle bg-body"><thead><tr><th>Nombre</th><th>Especialidad</th><th>Colegiado</th><th>Disponible</th><th></th></tr></thead><tbody>
@foreach (var o in lista)
{
    <tr><td>@o.Nombre</td><td>@o.Especialidad</td><td>@o.NumeroColegiado</td><td>@(o.Disponible ? "Sí" : "No")</td>
        <td><AuthorizeView Roles="Administrador"><button class="btn btn-sm btn-outline-primary" @onclick="() => Alternar(o.IdOdontologo)">Cambiar disponibilidad</button></AuthorizeView></td></tr>
}
</tbody></table></div>
@code {
    List<Odontologo> lista = new(); Odontologo? nuevo; string? err;
    protected override async Task OnInitializedAsync() => await Cargar();
    async Task Cargar() { await using var db = await F.CreateDbContextAsync(); lista = await db.Odontologos.OrderBy(o => o.Nombre).ToListAsync(); }
    async Task Guardar()
    {
        await using var db = await F.CreateDbContextAsync(); db.Odontologos.Add(nuevo!);
        try { await db.SaveChangesAsync(); } catch (DbUpdateException) { err = "Ese número de colegiado ya existe."; return; } // RD-03
        nuevo = null; err = null; await Cargar();
    }
    async Task Alternar(Guid id) { await using var db = await F.CreateDbContextAsync(); var o = await db.Odontologos.FindAsync(id); if (o == null) return; o.Disponible = !o.Disponible; await db.SaveChangesAsync(); await Cargar(); }
}
