@using Microsoft.AspNetCore.Components.Endpoints
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="ConfiDent, clínica odontológica en Managua. Consulte servicios y solicite su cita en línea." />
    <meta name="theme-color" content="#8b376c" />
    <base href="/" />
    <title>ConfiDent – Clínica Odontológica</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&amp;family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png?v=2" />
    <link href="app.css" rel="stylesheet" />
    <script src="app.js"></script>
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
